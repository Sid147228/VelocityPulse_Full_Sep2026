# Flask session security
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Microsoft Entra ID application registration
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-client-secret-value

# Use your Directory (tenant) ID for organisation-only access.
# Use "common" only if the app registration is configured for broader Microsoft account access.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Must exactly match a Web redirect URI configured in the Entra app registration.
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/callback
MICROSOFT_POST_LOGOUT_REDIRECT_URI=http://localhost:5000/login

# Minimal delegated permission used by the sign-in flow.
MICROSOFT_SCOPES=User.Read

# Set true only when VelocityPulse is served over HTTPS.
SESSION_COOKIE_SECURE=false


# JMeter HTML report compatibility
# Match these to jmeter.reportgenerator.statistic_window and
# jmeter.reportgenerator.overall_granularity if your organisation customises them.
JMETER_REPORT_STATISTIC_WINDOW=20000
JMETER_REPORT_GRANULARITY_MS=60000


# Local JMeter executable used by Run Test
JMETER_EXECUTABLE=C:\apache-jmeter-5.6.3\apache-jmeter-5.6.3\bin\jmeter.bat
