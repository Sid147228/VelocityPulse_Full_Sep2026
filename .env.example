# Flask session security
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# PIN authentication
# SQLite database used for registered users and lockout state.
PIN_AUTH_DB_PATH=instance/velocitypulse_auth.db

# Optional server-side pepper added before PIN hashing.
# Set this to a long random value in production and do not change it after users register.
PIN_PEPPER=replace-with-a-long-random-secret

# Recommended for organisation deployments.
# If set, first-time registration requires this shared registration code.
PIN_REGISTRATION_CODE=replace-with-an-organisation-registration-code

# Optional comma-separated allowlist. Leave blank to allow any valid email domain.
# Example: company.com,subsidiary.co.uk
PIN_ALLOWED_EMAIL_DOMAINS=

# Login protection
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# Session inactivity timeout in minutes.
PIN_SESSION_MINUTES=480

# Set true only when VelocityPulse is served over HTTPS.
SESSION_COOKIE_SECURE=false

# JMeter HTML report compatibility
# Match these to jmeter.reportgenerator.statistic_window and
# jmeter.reportgenerator.overall_granularity if your organisation customises them.
JMETER_REPORT_STATISTIC_WINDOW=20000
JMETER_REPORT_GRANULARITY_MS=60000

# Local JMeter executable used by Run Test
JMETER_EXECUTABLE=C:\apache-jmeter-5.6.3\apache-jmeter-5.6.3\bin\jmeter.bat
